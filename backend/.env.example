# Copy to .env (never commit real values). Separate values per environment (development | staging | production).
APP_ENV=development
PORT=3000

# Neon PostgreSQL. DATABASE_URL = pooled connection (host contains "-pooler") used by the running app.
# DIRECT_DATABASE_URL = direct (non-pooled) connection used only by `prisma migrate`.
# Both must include sslmode=require. Use a least-privilege role for the app (see docs/deployment).
DATABASE_URL=postgresql://APP_USER:CHANGE_ME@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DIRECT_DATABASE_URL=postgresql://MIGRATE_USER:CHANGE_ME@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS
# 32-byte key, base64, used to encrypt MFA secrets at rest
DATA_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES

# Comma-separated browser/web origins allowed by CORS (native apps do not send Origin). Empty = none.
CORS_ORIGINS=

# Brevo transactional e-mail (https://app.brevo.com → SMTP & API → API keys). EMAIL_FROM must be a verified sender in Brevo.
# Leave BREVO_API_KEY empty in development: e-mails are then captured in memory (and never sent).
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Makarifor Poultry

# Optional Expo push access token (recommended when "enhanced push security" is enabled in Expo)
PUSH_NOTIFICATION_CONFIG=
# expo | none. Defaults to expo in staging/production and none in development/test.
PUSH_PROVIDER=

LOG_LEVEL=info

# Keeps a serverless database (Neon) awake so the first request after a quiet period is not slow. Seconds; 0 = off. Default 240 in staging/production.
DB_KEEPALIVE_SECONDS=

# ── Backups (Super Admin → Administration → Backups) ──
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MUST differ from DATA_ENCRYPTION_KEY and be kept somewhere OTHER than the backups (password manager / secrets vault). Lose it = backups unreadable.
BACKUP_ENCRYPTION_KEY=
# 1 = on, 0 = off. Default: on in staging/production (needs the key above), off elsewhere.
BACKUP_ENABLED=
# local = a folder on the API server (NOT a real backup: it dies with the server). s3 = any S3-compatible bucket (AWS S3, Cloudflare R2, Backblaze B2, Wasabi).
BACKUP_STORAGE=local
BACKUP_LOCAL_DIR=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=makarifor/
# Folder containing pg_dump / pg_restore if they are not on PATH (must be >= your PostgreSQL major version)
BACKUP_PG_BIN_DIR=
# Comma-separated alert addresses; empty = every active Super Admin
BACKUP_ALERT_EMAILS=
# Alert when the newest good backup is older than this many hours
BACKUP_STALE_HOURS=26
# A server where scratch/recovery databases may be created (user needs CREATEDB). Never your production database's server user for day-to-day use;
# ideally a separate Neon project/branch or Postgres instance. Used for restore tests and recoveries.
RECOVERY_ADMIN_DATABASE_URL=
