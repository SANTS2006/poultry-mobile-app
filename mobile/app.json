{
  "expo": {
    "name": "Makarifor Poultry",
    "slug": "makarifor-poultry",
    "scheme": "makarifor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.makarifor.poultry",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock Makarifor Poultry.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.makarifor.poultry",
      "adaptiveIcon": {
        "backgroundColor": "#0F5132",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT", "POST_NOTIFICATIONS"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "backgroundColor": "#0F5132", "image": "./assets/images/splash-icon.png", "imageWidth": 120 }],
      ["expo-local-authentication", { "faceIDPermission": "Use Face ID to unlock Makarifor Poultry." }],
      ["expo-notifications", { "color": "#0F5132" }],
      ["expo-image-picker", { "photosPermission": "Choose a profile picture from your photos.", "cameraPermission": "Take a profile picture.", "microphonePermission": false }],
      ["expo-sqlite", { "useSQLCipher": true }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
