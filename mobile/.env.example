# Public build-time configuration (embedded in the app bundle — never put secrets here).
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENV=development
# "Sign in with Google" (leave blank to hide the button). Web OAuth client id from Google Cloud; the server needs the same id in GOOGLE_CLIENT_IDS.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
